# Copy to apps/web/.env and fill in the values.

NODE_ENV=development

# FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Same Postgres as the API (docker compose db). No "+asyncpg" here.
DATABASE_URL=postgres://deepscout:deepscout@localhost:5432/deepscout
