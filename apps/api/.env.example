# Copy to apps/api/.env and fill in the values.

# Database (docker compose db). The +asyncpg part tells SQLAlchemy which driver to use.
DATABASE_URL=postgresql+asyncpg://deepscout:deepscout@localhost:5432/deepscout

# LLM provider keys (LiteLLM reads these exact names)
GEMINI_API_KEY=
GROQ_API_KEY=

# Model names in LiteLLM format: provider/model-id
# Check each provider's current free models before filling these in.
# Gemini and Groq are each other's fallback, so no separate fallback model is needed.
LLM_MAIN_MODEL=gemini/gemini-3.5-flash
LLM_FAST_MODEL=groq/openai/gpt-oss-120b
EMBEDDING_MODEL=gemini/gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Frontend origin allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3001

# Langfuse tracing (Part 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
